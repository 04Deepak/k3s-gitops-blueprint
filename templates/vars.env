# ============================================================
# k3s-gitops-blueprint — vars.env
# Single source of truth for all {{PLACEHOLDER}} tokens.
# ALL VALUES BELOW ARE FICTIONAL EXAMPLES (acme, example.com,
# 203.0.113.0/24 is a documentation-only IP range).
# Replace every value, then run:  ./init.sh
# Never commit real passwords, IPs or tokens.
# ============================================================

# === Project Identity ===
# Short kebab-case name used in resource names and labels.
PROJECT_NAME=acme
# Kubernetes namespace for production workloads.
NAMESPACE=acme
# Kubernetes namespace for staging workloads.
STAGING_NAMESPACE=acme-staging

# === Domains ===
# Public domain for the production app (DNS A-record → SERVER_IP).
DOMAIN=app.example.com
# Public domain for the staging app.
STAGING_DOMAIN=staging.example.com
# Domain for the ArgoCD web UI.
ARGOCD_DOMAIN=argocd.example.com
# Domain for the Infisical web UI.
INFISICAL_DOMAIN=infisical.example.com

# === Container Registry (GHCR) ===
# GitHub org or user that owns the container images.
GHCR_ORG=acme-org
# Full GHCR image path for the backend.
BACKEND_IMAGE=ghcr.io/acme-org/acme-backend
# Full GHCR image path for the frontend.
FRONTEND_IMAGE=ghcr.io/acme-org/acme-frontend
# Initial image tag (CI overwrites it on each deploy). Pin a version, never "latest".
IMAGE_TAG=v1.0.0

# === Database ===
# Production database name.
DB_NAME=acme_platform
# Staging database name (same Postgres instance, different DB).
DB_STAGING_NAME=acme_platform_staging
# Application-scoped DB user (limited privileges).
DB_USER=acme_app
# Password for the application DB user.
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# Postgres superuser (used by the StatefulSet).
DB_SUPERUSER=db_admin
# Superuser password.
DB_SUPERUSER_PASSWORD=CHANGE_ME_SUPER_PASSWORD
# Pinned ClusterIP for the Postgres Service (stable for SSH tunnels).
POSTGRES_CLUSTERIP=10.43.100.100

# === Server ===
# Public IP of the VPS / bare-metal node (203.0.113.0/24 = documentation range).
SERVER_IP=203.0.113.10
# SSH config alias for the server.
SSH_HOST=acme-server
# SSH user (use a non-root sudo user).
SSH_USER=deploy
# Path to the SSH private key.
SSH_KEY=~/.ssh/id_ed25519

# === GitOps ===
# SSH clone URL for the devops/manifests repo (used by ArgoCD).
DEVOPS_REPO=git@github.com:acme-org/acme-devops.git
# HTTPS clone URL (used by CI to push image-tag updates).
DEVOPS_REPO_HTTPS=https://github.com/acme-org/acme-devops.git
# Devops repo name only (without owner, used in CI clone steps).
DEVOPS_REPO_NAME=acme-devops

# === Infisical ===
# Infisical project ID (UUID from the Infisical UI). Example below is a dummy.
INFISICAL_PROJECT_ID=00000000-0000-0000-0000-000000000000
# Infisical project slug.
INFISICAL_PROJECT_SLUG=acme-platform-x1y2z
# Infisical environment name for production secrets.
INFISICAL_ENV=prod
# Infisical environment name for staging secrets.
INFISICAL_STAGING_ENV=staging
# In-cluster Infisical API URL (used by the secrets operator).
INFISICAL_API_URL=http://infisical-backend.infisical.svc.cluster.local:8080/api

# === AWS / S3 ===
# AWS region for S3 buckets.
AWS_REGION=ap-south-1
# S3 bucket for database backups (isolated from uploads).
S3_BACKUP_BUCKET=acme-example-backups
# S3 bucket for user-uploaded files.
S3_UPLOADS_BUCKET=acme-example-uploads

# === GitHub Actions ===
# GitHub owner (org or user) for CI workflows.
GH_REPO_OWNER=acme-org
# Backend repo name (without owner prefix).
GH_BACKEND_REPO=acme-backend
# Frontend repo name.
GH_FRONTEND_REPO=acme-frontend

# === Backend Config ===
# K8s Service name for the backend (used in nginx proxy_pass).
BACKEND_SERVICE=backend-service
# Port the backend listens on inside the container.
BACKEND_PORT=5000
# HPA minimum replicas.
BACKEND_MIN_REPLICAS=2
# HPA maximum replicas.
BACKEND_MAX_REPLICAS=8
# HPA CPU utilization target (%).
BACKEND_CPU_TARGET=80
# Memory limit for backend pods.
BACKEND_MEMORY_LIMIT=1536Mi
# Memory request for backend pods.
BACKEND_MEMORY_REQUEST=384Mi

# === Frontend Config ===
# Number of frontend replicas (no HPA — static).
FRONTEND_REPLICAS=1
# Memory limit for frontend (nginx) pods.
FRONTEND_MEMORY_LIMIT=128Mi

# === PgBouncer ===
# Default connection pool size per database.
PGBOUNCER_POOL_SIZE=12
# Maximum client connections PgBouncer will accept.
PGBOUNCER_MAX_CLIENT_CONN=1000
# Minimum pool size kept open.
PGBOUNCER_MIN_POOL_SIZE=5

# === Redis ===
# Maximum memory Redis is allowed to use.
REDIS_MAX_MEMORY=200mb
# Eviction policy when maxmemory is reached.
REDIS_POLICY=allkeys-lru

# === Monitoring ===
# Domain for the Grafana web UI.
GRAFANA_DOMAIN=grafana.example.com
# How long Prometheus keeps metrics.
PROMETHEUS_RETENTION=7d
# Prometheus volume size (local-path PVC).
PROMETHEUS_STORAGE=10Gi
# Slack channel for alerts.
ALERT_SLACK_CHANNEL=#alerts
